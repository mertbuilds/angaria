# Polar sandbox. Public build-time values (they ship in the app bundle), no secrets.
VITE_POLAR_API_BASE=https://sandbox-api.polar.sh
VITE_POLAR_ORGANIZATION_ID=904c54ce-20e8-4a7e-bee9-fef5f8990517
VITE_POLAR_CHECKOUT_URL=https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_IfeDpqmO9y2e56rqB7FIB0v3oikkgnuUeYBSr1q4yiG/redirect
VITE_POLAR_PORTAL_URL=https://sandbox.polar.sh/mertbuilds/portal

# Set VITE_LICENSE_BYPASS=1 (here, in .env.development.local or the shell) to skip
# the license gate. Dev server only: production builds ignore it.

# Dev only: the local GİB emulator (`pnpm emulate`, packages/gib-emulator) behind
# Ayarlar › GİB hesabı › Emülatör. Plain http on loopback, not the portless https
# alias: the Tauri http plugin (reqwest with rustls and bundled roots) does not
# trust portless's local CA. src-tauri/tauri.dev.conf.json allows this exact URL.
VITE_GIB_EMULATOR_URL=http://127.0.0.1:5180
