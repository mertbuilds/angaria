# Polar sandbox, Angaria org. Public build-time values (they ship in the app bundle), no secrets.
VITE_POLAR_API_BASE=https://sandbox-api.polar.sh
VITE_POLAR_ORGANIZATION_ID=271d927a-c128-434e-9e75-22283350c94f
# The yearly plan's checkout link: the license screen's checkout link opens it.
VITE_POLAR_CHECKOUT_URL=https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_0V5sUhd7aAb6HwGUkxuvStKvdZsLh1LLST0Pr32oMn2/redirect
VITE_POLAR_PORTAL_URL=https://sandbox.polar.sh/angaria/portal

# Set VITE_LICENSE_BYPASS=1 (here, in .env.development.local or the shell) to skip
# the license gate. Dev server only: production builds ignore it.

# Dev only: the local GİB emulator (`pnpm emulate`, packages/gib-emulator) behind
# Ayarlar › Gelişmiş › Emülatör. Plain http on loopback, not the portless https
# alias: the Tauri http plugin (reqwest with rustls and bundled roots) does not
# trust portless's local CA. src-tauri/tauri.dev.conf.json allows this exact URL.
VITE_GIB_EMULATOR_URL=http://127.0.0.1:5180
