{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Angaria",
  "version": "0.1.0",
  "identifier": "com.vinena.angaria",
  "build": {
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp run angaria-earsiv-sdk#build && vp run angaria-utils#build && vp build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Angaria",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
