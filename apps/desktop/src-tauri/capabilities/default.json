{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-destroy",
    "allow-vault-read",
    "allow-vault-write",
    "allow-secret-get",
    "allow-secret-delete",
    "allow-mcp-start",
    "allow-mcp-stop",
    "allow-mcp-status",
    "allow-mcp-respond",
    "allow-mcp-token",
    "allow-mcp-rotate-token",
    "allow-mcp-install",
    "allow-html-to-pdf",
    "allow-save-download",
    "updater:default",
    "process:allow-restart",
    "os:allow-hostname",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOWNLOAD/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://polar.sh/*"
        },
        {
          "url": "https://buy.polar.sh/*"
        },
        {
          "url": "https://api.polar.sh/*"
        },
        {
          "url": "https://angaria.app/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://earsivportal.efatura.gov.tr/*"
        },
        {
          "url": "https://www.tcmb.gov.tr/kurlar/*"
        },
        {
          "url": "https://api.polar.sh/*"
        }
      ]
    }
  ]
}
