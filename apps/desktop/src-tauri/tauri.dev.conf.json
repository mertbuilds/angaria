{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.vinena.angaria.dev",
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns"
    ]
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "gib-emulator",
          "description": "Dev only: lets the http plugin reach the local GİB emulator (pnpm emulate). Merged by `tauri dev --config src-tauri/tauri.dev.conf.json`, never by a release build.",
          "windows": ["main"],
          "permissions": [
            {
              "identifier": "http:default",
              "allow": [{ "url": "http://127.0.0.1:5180/*" }]
            }
          ]
        }
      ]
    }
  }
}
