# Production values. Public build-time values (they ship in the page), no secrets.
# TODO(go-live): the Polar production checkout link. The `deploy` script refuses to
# build while it is empty (see vite.config.ts).
VITE_CHECKOUT_URL=
VITE_DOWNLOAD_URL=https://dl.angaria.app/latest/Angaria.dmg
# TODO(go-live): the PostHog EU project key. Empty = analytics off.
VITE_POSTHOG_KEY=
# Where the browser sends events. Empty = /ingest, the Worker's proxy to PostHog EU.
VITE_POSTHOG_HOST=
