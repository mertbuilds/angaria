# Dev server values. Public build-time values (they ship in the page), no secrets.
# Polar sandbox checkout links, one per plan (a product each, the same license key).
VITE_CHECKOUT_URL_YEARLY=https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_9MhlbzbFNTuH3K7YR6BpFggDXlfzwPJ5lWq8C1darw3/redirect
VITE_CHECKOUT_URL_MONTHLY=https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_iJgnZeFywGVYOjNUZCKR5FxFwRUY2bCiNJ7wx0S0wbj/redirect
VITE_DOWNLOAD_URL=https://dl.angaria.app/latest/Angaria.dmg
# PostHog project key (EU). Empty = analytics off. Put a key in .env.development.local to test it.
VITE_POSTHOG_KEY=
# Where the browser sends events. Empty = /ingest, the Worker's proxy to PostHog EU.
VITE_POSTHOG_HOST=
