# Dev server values. Public build-time values (they ship in the page), no secrets.
VITE_DOWNLOAD_URL=https://dl.angaria.app/latest/Angaria.dmg
# PostHog project key (EU). Empty = analytics off. Put a key in .env.development.local to test it.
VITE_POSTHOG_KEY=
# Where the browser sends events. Empty = /ingest, the Worker's proxy to PostHog EU.
VITE_POSTHOG_HOST=
