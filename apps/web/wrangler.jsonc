{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angaria-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry: wraps @tanstack/react-start/server-entry with the www redirect
  // and the paraglide middleware.
  "main": "src/server.ts",
  // The apex is the canonical host. www is a custom domain on this same Worker
  // so `canonicalRedirect` in src/server.ts can 301 it itself. Nothing is
  // deployed yet: `pnpm --filter web run deploy` creates both on the first run.
  "routes": [
    { "pattern": "angaria.app", "custom_domain": true },
    { "pattern": "www.angaria.app", "custom_domain": true },
  ],
  // No request logs: the site promises anonymous analytics and nothing more.
  "observability": {
    "enabled": false,
  },
}
