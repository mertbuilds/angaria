{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://earsivportal.efatura.gov.tr/*"
        },
        {
          "url": "https://earsivportaltest.efatura.gov.tr/*"
        }
      ]
    }
  ]
}
