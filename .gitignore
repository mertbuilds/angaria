# dependencies
node_modules/

# build output
dist/
dist-ssr/
.output/
.vite/
storybook-static/

# caches
.turbo/
.cloudflare/
.wrangler/
coverage/
*.tsbuildinfo

# env, only the example is committed
.env*
!.env.example
# desktop build-time config: public VITE_ values that ship in the app bundle
!apps/desktop/.env.development
!apps/desktop/.env.production
# web build-time config: public VITE_ values that ship in the page
!apps/web/.env.development
!apps/web/.env.production
*.local

# generated code (rebuilt by dev / build)
apps/web/src/paraglide/
apps/web/src/routeTree.gen.ts

# licensed fonts, fetched by scripts/fetch-fonts.sh, never committed
packages/ui/fonts/*.woff2
packages/ui/fonts/*.ttf
packages/ui/fonts/*.part

# logs
logs
*.log

# editor and os
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
